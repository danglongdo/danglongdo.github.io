---
import type { CollectionEntry } from 'astro:content';
import type { MarkdownHeading } from 'astro';
import BaseLayout from './BaseLayout.astro';
import Footer from '../components/Footer.astro';
import siteConfig from '../config/site';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslations, useTranslatedPath } from '../i18n/utils';
import NalArchitectureDiagram from '../components/diagrams/NalArchitectureDiagram.astro';
import SlmsArchitectureDiagram from '../components/diagrams/SlmsArchitectureDiagram.astro';
import CodelearnArchitectureDiagram from '../components/diagrams/CodelearnArchitectureDiagram.astro';

export interface Props {
  project: CollectionEntry<'projects'>;
  prev?: CollectionEntry<'projects'>;
  next?: CollectionEntry<'projects'>;
  headings?: MarkdownHeading[];
  class?: string;
}

const { project, prev, next, class: className = '' } = Astro.props;
const data = project.data;
const locale = (data.locale ?? 'en') as SupportedLanguage;

const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);

const categoryMap: Record<string, { en: string; vi: string }> = {
  'nal-ai-automation-erp': {
    en: 'Enterprise AI & Internal ERP',
    vi: 'AI Doanh nghiệp & ERP Nội bộ',
  },
  'sep490-construction-slms': {
    en: 'Distributed Systems & .NET',
    vi: 'Hệ thống Phân tán & .NET',
  },
  'codelearn-community-content': {
    en: 'High-Traffic Web & Microservices',
    vi: 'Hệ thống Web & Microservices',
  },
};

const defaultCategory = locale === 'vi' ? 'Hệ thống Doanh nghiệp' : 'Enterprise Systems';
const category = categoryMap[data.slug]?.[locale] ?? defaultCategory;

// Security check: ensure restricted repos are never rendered as clickable links
const isRestrictedRepo = data.repoUrl?.includes('sep490-backend');
const safeRepoUrl = isRestrictedRepo ? undefined : data.repoUrl;

const homeUrl = translatePath('/');
const projectsSectionUrl = translatePath('/#projects');

const pageTitle = `${data.title} | ${siteConfig.name}`;
const pageDescription = data.summary;

// Structural takeaways list
const takeaways = [
  {
    label: t('project.challenge'),
    content: data.challenge,
    icon: 'challenge',
  },
  {
    label: t('project.ownership'),
    content: data.ownership,
    icon: 'ownership',
  },
  {
    label: t('project.approach'),
    content: data.approach,
    icon: 'approach',
  },
  {
    label: t('project.solution'),
    content: data.solution,
    icon: 'solution',
  },
  {
    label: t('project.outcome'),
    content: data.outcome,
    icon: 'outcome',
  },
  {
    label: t('project.reflection'),
    content: data.reflection,
    icon: 'reflection',
  },
].filter((item) => Boolean(item.content));
---

<BaseLayout title={pageTitle} description={pageDescription} lang={locale} ogType="article">
  <div class:list={['py-8 sm:py-12 md:py-16', className]}>
    <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8">
      <!-- Breadcrumb Navigation -->
      <nav aria-label="Breadcrumbs" class="mb-8 sm:mb-10">
        <div class="flex flex-wrap items-center gap-2 text-xs font-mono text-muted dark:text-muted-dark">
          <a
            href={projectsSectionUrl}
            class="inline-flex items-center gap-1.5 px-2.5 py-1.5 rounded-md bg-surface dark:bg-surface-dark border border-border dark:border-border-dark text-ink dark:text-ink-dark hover:text-accent dark:hover:text-accent-dark hover:border-accent/40 dark:hover:border-accent-dark/40 transition-colors focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none"
            aria-label={t('project.backToProjects')}
          >
            <svg
              class="w-3.5 h-3.5"
              fill="none"
              viewBox="0 0 24 24"
              stroke-width="2"
              stroke="currentColor"
              aria-hidden="true"
            >
              <path stroke-linecap="round" stroke-linejoin="round" d="M10.5 19.5 3 12m0 0 7.5-7.5M3 12h18" />
            </svg>
            <span>{t('project.backToProjects')}</span>
          </a>

          <span class="text-border dark:text-border-dark" aria-hidden="true">/</span>
          <span class="text-muted dark:text-muted-dark truncate max-w-[200px] sm:max-w-xs">{data.title}</span>
        </div>
      </nav>

      <!-- Case Study Hero Header -->
      <header class="mb-10 sm:mb-14">
        <div class="flex flex-wrap items-center gap-2 mb-4">
          <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-mono font-medium bg-surface dark:bg-surface-dark text-muted dark:text-muted-dark border border-border dark:border-border-dark">
            {category}
          </span>

          {data.highlight && (
            <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-accent/10 text-accent dark:bg-accent-dark/15 dark:text-accent-dark border border-accent/20 dark:border-accent-dark/30">
              <span class="w-1.5 h-1.5 rounded-full bg-accent dark:bg-accent-dark" aria-hidden="true" />
              {t('project.featured')}
            </span>
          )}

          {data.timeline && (
            <span class="inline-flex items-center gap-1 px-2.5 py-0.5 rounded text-xs font-mono text-muted dark:text-muted-dark bg-canvas dark:bg-canvas-dark border border-border/80 dark:border-border-dark/80">
              <svg class="w-3 h-3" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6h4.5m4.5 0a9 9 0 1 1-18 0 9 9 0 0 1 18 0Z" />
              </svg>
              <span>{data.timeline}</span>
            </span>
          )}
        </div>

        <h1 class="text-3xl sm:text-4xl md:text-5xl font-bold tracking-tight text-ink dark:text-ink-dark leading-[1.15] mb-6">
          {data.title}
        </h1>

        <p class="text-lg sm:text-xl text-muted dark:text-muted-dark leading-relaxed max-w-3xl">
          {data.summary}
        </p>
      </header>

      <!-- Security / NDA Notice Banner -->
      {data.securityNotice && (
        <aside
          role="note"
          aria-label={t('project.ndaNotice')}
          class="mb-10 sm:mb-12 p-4 sm:p-5 rounded-xl border border-amber-500/30 dark:border-amber-400/30 bg-amber-500/5 dark:bg-amber-400/5 flex items-start gap-3.5"
        >
          <div class="p-1.5 rounded-lg bg-amber-500/10 dark:bg-amber-400/10 text-amber-600 dark:text-amber-400 shrink-0 mt-0.5">
            <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.5 10.5V6.75a4.5 4.5 0 1 0-9 0v3.75m-.75 11.25h10.5a2.25 2.25 0 0 0 2.25-2.25v-6.75a2.25 2.25 0 0 0-2.25-2.25H6.75a2.25 2.25 0 0 0-2.25 2.25v6.75a2.25 2.25 0 0 0 2.25 2.25Z" />
            </svg>
          </div>
          <div>
            <h2 class="text-sm font-semibold text-ink dark:text-ink-dark flex items-center gap-2">
              <span>{t('project.ndaNotice')}</span>
              <span class="text-[11px] font-mono px-1.5 py-0.2 rounded bg-amber-500/20 text-amber-700 dark:text-amber-300">
                {t('project.confidential')}
              </span>
            </h2>
            <p class="text-xs sm:text-sm text-muted dark:text-muted-dark mt-1 leading-relaxed">
              {data.securityNotice}
            </p>
          </div>
        </aside>
      )}

      <!-- Metadata Box -->
      <section
        aria-label={t('project.executiveSummary')}
        class="mb-12 p-6 rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark shadow-xs"
      >
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6">
          <!-- Role -->
          <div>
            <span class="block text-xs font-mono font-semibold uppercase tracking-wider text-muted dark:text-muted-dark mb-1.5">
              {t('project.role')}
            </span>
            <span class="text-sm font-medium text-ink dark:text-ink-dark">
              {data.role}
            </span>
          </div>

          <!-- Timeline -->
          <div>
            <span class="block text-xs font-mono font-semibold uppercase tracking-wider text-muted dark:text-muted-dark mb-1.5">
              {t('project.timeline')}
            </span>
            <span class="text-sm font-mono text-ink dark:text-ink-dark">
              {data.timeline}
            </span>
          </div>

          <!-- Links (Repo / Demo) -->
          <div class="sm:col-span-2">
            <span class="block text-xs font-mono font-semibold uppercase tracking-wider text-muted dark:text-muted-dark mb-1.5">
              {locale === 'vi' ? 'Liên kết trực tiếp' : 'Direct Links'}
            </span>
            <div class="flex flex-wrap items-center gap-2.5">
              {safeRepoUrl && (
                <a
                  href={safeRepoUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-border dark:border-border-dark bg-canvas dark:bg-canvas-dark text-xs font-mono font-medium text-ink dark:text-ink-dark hover:text-accent dark:hover:text-accent-dark hover:border-accent dark:hover:border-accent-dark transition-colors focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none"
                  aria-label={`${t('project.repository')} (${data.title})`}
                >
                  <svg class="w-3.5 h-3.5 text-muted dark:text-muted-dark" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                    <path fill-rule="evenodd" clip-rule="evenodd" d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z" />
                  </svg>
                  <span>{t('project.repository')}</span>
                  <svg class="w-3 h-3 text-muted dark:text-muted-dark opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                  </svg>
                </a>
              )}

              {data.liveUrl && (
                <a
                  href={data.liveUrl}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="inline-flex items-center gap-1.5 px-3 py-1.5 rounded-lg border border-accent/40 dark:border-accent-dark/40 bg-accent/5 dark:bg-accent-dark/10 text-xs font-mono font-medium text-accent dark:text-accent-dark hover:bg-accent hover:text-white dark:hover:bg-accent-dark dark:hover:text-canvas transition-colors focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none"
                  aria-label={`${t('project.liveDemo')} (${data.title})`}
                >
                  <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 21a9.004 9.004 0 0 0 8.716-6.747M12 21a9.004 9.004 0 0 1-8.716-6.747M12 21c2.485 0 4.5-4.03 4.5-9S14.485 3 12 3m0 18c-2.485 0-4.5-4.03-4.5-9S9.515 3 12 3m0 0a8.997 8.997 0 0 1 7.843 4.582M12 3a8.997 8.997 0 0 0-7.843 4.582m15.686 0A11.953 11.953 0 0 1 12 10.5c-2.998 0-5.74-1.1-7.843-2.918m15.686 0A8.959 8.959 0 0 1 21 12c0 .778-.099 1.533-.284 2.253m0 0A17.919 17.919 0 0 1 12 16.5c-3.162 0-6.133-.815-8.716-2.247m0 0A9.015 9.015 0 0 1 3 12c0-1.605.42-3.113 1.157-4.418" />
                  </svg>
                  <span>{t('project.liveDemo')}</span>
                  <svg class="w-3 h-3 opacity-70" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.5 6H5.25A2.25 2.25 0 0 0 3 8.25v10.5A2.25 2.25 0 0 0 5.25 21h10.5A2.25 2.25 0 0 0 18 18.75V10.5m-10.5 6L21 3m0 0h-5.25M21 3v5.25" />
                  </svg>
                </a>
              )}

              {!safeRepoUrl && !data.liveUrl && (
                <span class="text-xs font-mono text-muted dark:text-muted-dark italic">
                  {locale === 'vi' ? 'Dự án nội bộ / Giới hạn quyền truy cập' : 'Internal project / Access restricted'}
                </span>
              )}
            </div>
          </div>

          <!-- Tech Stack -->
          {Array.isArray(data.techStack) && data.techStack.length > 0 && (
            <div class="sm:col-span-2 lg:col-span-4 pt-4 border-t border-border/70 dark:border-border-dark/70">
              <span class="block text-xs font-mono font-semibold uppercase tracking-wider text-muted dark:text-muted-dark mb-2">
                {t('project.techStack')}
              </span>
              <div class="flex flex-wrap gap-1.5" aria-label={t('project.techStack')}>
                {data.techStack.map((tech) => (
                  <span class="inline-flex items-center px-2.5 py-1 rounded font-mono text-xs bg-canvas dark:bg-canvas-dark text-muted dark:text-muted-dark border border-border dark:border-border-dark">
                    {tech}
                  </span>
                ))}
              </div>
            </div>
          )}
        </div>
      </section>

      <!-- Structural Case Study Takeaways Bento -->
      {takeaways.length > 0 && (
        <section aria-labelledby="takeaways-heading" class="mb-14 sm:mb-16">
          <div class="flex items-center gap-2 mb-6">
            <span class="font-mono text-xs uppercase tracking-wider text-accent dark:text-accent-dark font-semibold">
              01 / Architecture Blueprint
            </span>
            <span class="h-px w-8 bg-border dark:bg-border-dark" aria-hidden="true" />
          </div>

          <h2 id="takeaways-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-ink dark:text-ink-dark mb-6">
            {t('project.takeaways')}
          </h2>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 sm:gap-6">
            {takeaways.map((item, index) => (
              <div class="p-5 sm:p-6 rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark flex flex-col justify-between">
                <div>
                  <div class="flex items-center justify-between gap-2 mb-3">
                    <h3 class="text-sm font-mono font-semibold uppercase tracking-wider text-ink dark:text-ink-dark flex items-center gap-2">
                      <span class="text-accent dark:text-accent-dark font-mono">0{index + 1}.</span>
                      <span>{item.label}</span>
                    </h3>
                  </div>
                  <p class="text-sm text-muted dark:text-muted-dark leading-relaxed">
                    {item.content}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </section>
      )}

      <!-- System Architecture & Data Flow Section -->
      <section aria-labelledby="architecture-diagram-heading" class="mb-14 sm:mb-16">
        <div class="flex items-center gap-2 mb-4">
          <span class="font-mono text-xs uppercase tracking-wider text-accent dark:text-accent-dark font-semibold">
            02 / {t('project.architectureSection')}
          </span>
          <span class="h-px w-8 bg-border dark:bg-border-dark" aria-hidden="true" />
        </div>

        <div class="flex flex-col sm:flex-row sm:items-baseline justify-between gap-2 mb-6">
          <h2 id="architecture-diagram-heading" class="text-2xl sm:text-3xl font-bold tracking-tight text-ink dark:text-ink-dark">
            {t('project.architectureSection')}
          </h2>
          <p class="text-xs sm:text-sm text-muted dark:text-muted-dark font-mono">
            {t('project.architectureSubtitle')}
          </p>
        </div>

        {data.slug === 'nal-ai-automation-erp' && <NalArchitectureDiagram locale={locale} />}
        {data.slug === 'sep490-construction-slms' && <SlmsArchitectureDiagram locale={locale} />}
        {data.slug === 'codelearn-community-content' && <CodelearnArchitectureDiagram locale={locale} />}
      </section>

      <!-- Technical Deep-Dive Markdown Body -->
      <section aria-labelledby="case-study-body-heading" class="mb-16 sm:mb-20">
        <div class="flex items-center gap-2 mb-6">
          <span class="font-mono text-xs uppercase tracking-wider text-accent dark:text-accent-dark font-semibold">
            03 / {locale === 'vi' ? 'Nội dung Phân tích Kỹ thuật' : 'Technical Case Study'}
          </span>
          <span class="h-px w-8 bg-border dark:bg-border-dark" aria-hidden="true" />
        </div>

        <h2 id="case-study-body-heading" class="sr-only">
          {locale === 'vi' ? 'Nội dung phân tích kỹ thuật' : 'Detailed Technical Analysis'}
        </h2>

        <div class="case-study-content max-w-4xl">
          <slot />
        </div>
      </section>

      <!-- Next / Previous Project Pagination -->
      {(prev || next) && (
        <nav aria-label={locale === 'vi' ? 'Điều hướng dự án' : 'Project Navigation'} class="pt-8 border-t border-border dark:border-border-dark">
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
            <!-- Previous Project -->
            {prev ? (
              <a
                href={translatePath(`/projects/${prev.data.slug}`)}
                class="group p-5 rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark hover:border-accent dark:hover:border-accent-dark transition-all duration-150 flex flex-col justify-between focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none"
              >
                <div>
                  <span class="text-xs font-mono text-muted dark:text-muted-dark flex items-center gap-1 mb-2 group-hover:text-accent dark:group-hover:text-accent-dark transition-colors">
                    <span aria-hidden="true">&larr;</span>
                    <span>{t('project.prevProject')}</span>
                  </span>
                  <h3 class="text-base font-bold text-ink dark:text-ink-dark group-hover:text-accent dark:group-hover:text-accent-dark transition-colors line-clamp-1">
                    {prev.data.title}
                  </h3>
                  <p class="text-xs text-muted dark:text-muted-dark mt-1 line-clamp-2">
                    {prev.data.summary}
                  </p>
                </div>
              </a>
            ) : (
              <div class="hidden sm:block" aria-hidden="true" />
            )}

            <!-- Next Project -->
            {next ? (
              <a
                href={translatePath(`/projects/${next.data.slug}`)}
                class="group p-5 rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark hover:border-accent dark:hover:border-accent-dark transition-all duration-150 flex flex-col justify-between text-right sm:text-right focus-visible:ring-2 focus-visible:ring-accent focus-visible:outline-none"
              >
                <div>
                  <span class="text-xs font-mono text-muted dark:text-muted-dark flex items-center justify-end gap-1 mb-2 group-hover:text-accent dark:group-hover:text-accent-dark transition-colors">
                    <span>{t('project.nextProject')}</span>
                    <span aria-hidden="true">&rarr;</span>
                  </span>
                  <h3 class="text-base font-bold text-ink dark:text-ink-dark group-hover:text-accent dark:group-hover:text-accent-dark transition-colors line-clamp-1">
                    {next.data.title}
                  </h3>
                  <p class="text-xs text-muted dark:text-muted-dark mt-1 line-clamp-2">
                    {next.data.summary}
                  </p>
                </div>
              </a>
            ) : (
              <div class="hidden sm:block" aria-hidden="true" />
            )}
          </div>
        </nav>
      )}
    </div>
  </div>

  <Footer slot="footer" lang={locale} as="div" />
</BaseLayout>

<style is:global>
  /* Editorial Case Study Typography & Markdown Rendering */
  .case-study-content {
    color: var(--color-ink);
    font-size: 1.0625rem;
    line-height: 1.75;
  }

  .case-study-content > * + * {
    margin-top: 1.5rem;
  }

  .case-study-content h1,
  .case-study-content h2,
  .case-study-content h3,
  .case-study-content h4 {
    color: var(--color-ink);
    font-weight: 700;
    letter-spacing: -0.02em;
    scroll-margin-top: 5rem;
  }

  .case-study-content h1 {
    font-size: 2rem;
    margin-top: 3rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--color-border);
  }

  .case-study-content h2 {
    font-size: 1.625rem;
    margin-top: 2.75rem;
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--color-border);
  }

  .case-study-content h3 {
    font-size: 1.25rem;
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .case-study-content h4 {
    font-size: 1.125rem;
    margin-top: 1.5rem;
    margin-bottom: 0.5rem;
  }

  .case-study-content p {
    color: var(--color-ink);
    opacity: 0.92;
    margin-bottom: 1.25rem;
    max-width: 72ch;
  }

  .case-study-content ul,
  .case-study-content ol {
    margin-top: 1rem;
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
    max-width: 72ch;
  }

  .case-study-content ul {
    list-style-type: disc;
  }

  .case-study-content ol {
    list-style-type: decimal;
  }

  .case-study-content li {
    margin-top: 0.5rem;
    margin-bottom: 0.5rem;
    color: var(--color-ink);
    opacity: 0.92;
  }

  .case-study-content li::marker {
    color: var(--color-accent);
  }

  .case-study-content strong {
    font-weight: 600;
    color: var(--color-ink);
  }

  .case-study-content hr {
    margin-top: 2.5rem;
    margin-bottom: 2.5rem;
    border: 0;
    border-top: 1px solid var(--color-border);
  }

  .case-study-content blockquote {
    margin-top: 1.5rem;
