---
import BaseLayout from '../layouts/BaseLayout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Portrait from '../components/Portrait.astro';
import SelectedWork from '../components/SelectedWork.astro';
import Timeline from '../components/Timeline.astro';
import CapabilityMatrix from '../components/CapabilityMatrix.astro';
import ContactBanner from '../components/ContactBanner.astro';
import siteConfig from '../config/site';

const lang = 'en';
const pageTitle = `${siteConfig.name} | ${siteConfig.title}`;
const pageDescription = siteConfig.description.en;
---

<BaseLayout title={pageTitle} description={pageDescription} lang={lang}>
  <Header lang={lang} slot="header" />

  <!-- Hero Section -->
  <section class="relative overflow-hidden pt-12 pb-16 sm:pt-16 sm:pb-20 md:pt-20 md:pb-24 border-b border-border/60">
    <!-- Subtle Ambient Architectural Glow -->
    <div
      class="absolute -top-24 -left-24 w-96 h-96 bg-accent/5 rounded-full blur-3xl pointer-events-none"
      aria-hidden="true"
    ></div>

    <div class="max-w-5xl mx-auto px-6">
      <div class="flex flex-col-reverse md:flex-row items-start md:items-center justify-between gap-10 md:gap-12 lg:gap-16">
        <!-- Text & Actions Content -->
        <div class="flex-1 min-w-0">
          <!-- Status & Availability Pill -->
          <div class="flex flex-wrap items-center gap-2.5 mb-6">
            <div
              class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-emerald-500/10 text-emerald-800 border border-emerald-500/20"
              role="status"
            >
              <span class="relative flex h-2 w-2" aria-hidden="true">
                <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
                <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
              </span>
              <span>Available for Strategic Roles</span>
            </div>

            <span class="hidden sm:inline-flex items-center gap-1.5 px-3 py-1 rounded-full text-xs font-mono text-muted bg-surface border border-border">
              <svg class="w-3 h-3 text-muted shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z" />
              </svg>
              <span>Hanoi, Vietnam • Remote / Hybrid</span>
            </span>
          </div>

          <!-- Primary Name H1 -->
          <h1 class="text-4xl sm:text-5xl lg:text-6xl font-extrabold tracking-tight text-ink leading-[1.08]">
            Đỗ Đăng Long
          </h1>

          <!-- Prominent Positioning Subtitle -->
          <p class="mt-3 sm:mt-4 text-xl sm:text-2xl font-bold text-accent font-mono tracking-tight">
            .NET Full-Stack &amp; Enterprise AI Automation Engineer
          </p>

          <!-- Core Value Proposition -->
          <p class="mt-5 sm:mt-6 text-base sm:text-lg text-muted leading-relaxed max-w-2xl">
            Architecting mission-critical enterprise systems with ASP.NET Core, distributed architectures, and autonomous AI agents for corporate workflows. Delivering resilient backend services, high-throughput message streaming, and intelligent workflow automation.
          </p>

          <!-- Architectural Core Focus Chips -->
          <div class="mt-6 flex flex-wrap gap-2 pt-1">
            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono bg-surface border border-border text-ink/80">
              ASP.NET Core 8
            </span>
            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono bg-surface border border-border text-ink/80">
              Clean Architecture &amp; DDD
            </span>
            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono bg-surface border border-border text-ink/80">
              Autonomous AI Workflows
            </span>
            <span class="inline-flex items-center px-2.5 py-1 rounded-md text-xs font-mono bg-surface border border-border text-ink/80">
              Distributed Redis Caching
            </span>
          </div>

          <!-- Primary Action CTAs -->
          <div class="mt-8 sm:mt-10 flex flex-wrap items-center gap-3 sm:gap-4">
            <a
              href="#projects"
              class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-accent hover:bg-accent-hover text-white font-medium text-sm sm:text-base shadow-sm hover:shadow transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
            >
              <span>View Selected Work</span>
              <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 14l-7 7m0 0l-7-7m7 7V3" />
              </svg>
            </a>

            <a
              href="#contact"
              class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl border border-border bg-surface hover:bg-canvas text-ink font-medium text-sm sm:text-base transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
            >
              <span>Get in Touch</span>
            </a>

            <a
              href="/resume.pdf"
              download
              class="inline-flex items-center justify-center gap-2 px-4 py-3 rounded-xl border border-border/80 bg-surface/60 hover:bg-surface text-muted hover:text-ink font-mono text-xs sm:text-sm transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2"
              aria-label="Download CV (PDF)"
            >
              <svg class="w-4 h-4 text-muted" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
              </svg>
              <span>Download CV</span>
            </a>
          </div>
        </div>

        <!-- Portrait Container -->
        <div class="shrink-0 mx-auto md:mx-0">
          <Portrait
            size="lg"
            alt="Portrait of Đỗ Đăng Long - .NET Full-Stack & Enterprise AI Automation Engineer"
            className="shadow-md"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Assembled Page Sections -->
  <SelectedWork lang={lang} />
  <Timeline lang={lang} />
  <CapabilityMatrix lang={lang} />
  <ContactBanner lang={lang} />

  <Footer lang={lang} slot="footer" as="div" />
</BaseLayout>
