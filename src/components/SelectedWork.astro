---
import { getCollection, type CollectionEntry } from 'astro:content';
import type { SupportedLanguage } from '../i18n/ui';
import ProjectCard from './ProjectCard.astro';
import { useTranslations } from '../i18n/utils';

export interface Props {
  projects?: CollectionEntry<'projects'>[];
  lang?: SupportedLanguage;
  id?: string;
  class?: string;
  description?: string;
}

const {
  projects: propProjects,
  lang: propLang,
  id = 'projects',
  class: className = '',
  description: propDescription,
} = Astro.props;

const locale: SupportedLanguage = propLang ?? 'en';
const t = useTranslations(locale);

// Retrieve projects for the active locale if not passed explicitly as props
const rawProjects = propProjects
  ?? (await getCollection('projects', (entry) => entry.data.locale === locale));

// Sort deterministically by order ascending
const sortedProjects = [...rawProjects].sort((a, b) => (a.data.order ?? 0) - (b.data.order ?? 0));

const defaultDescription =
  locale === 'vi'
    ? 'Kiến trúc hệ thống doanh nghiệp cốt lõi, tác tử AI tự trị và nền tảng xử lý dữ liệu phân tán.'
    : 'Architecting mission-critical enterprise systems, autonomous AI agents, and distributed backend platforms.';

const sectionDescription = propDescription ?? defaultDescription;
---

<section
  id={id}
  aria-labelledby={`${id}-heading`}
  class:list={['py-12 md:py-20', className]}
>
  <div class="max-w-5xl mx-auto px-6">
    <!-- Section Header -->
    <div class="mb-8 md:mb-12">
      <div class="flex items-center gap-2 mb-2">
        <span class="font-mono text-xs uppercase tracking-wider text-accent dark:text-accent-dark font-semibold">
          01 / Selected Work
        </span>
        <span class="h-px w-8 bg-border dark:bg-border-dark" aria-hidden="true" />
      </div>

      <h2
        id={`${id}-heading`}
        class="text-3xl md:text-4xl font-bold tracking-tight text-ink dark:text-ink-dark"
      >
        {t('section.selectedWork')}
      </h2>

      {sectionDescription && (
        <p class="mt-3 text-base md:text-lg text-muted dark:text-muted-dark max-w-2xl leading-relaxed">
          {sectionDescription}
        </p>
      )}
    </div>

    <!-- Showcase Grid -->
    {sortedProjects.length > 0 ? (
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-6 md:gap-8">
        {sortedProjects.map((project, index) => {
          // Editorial emphasis: primary featured project receives full-width span
          const isPrimaryFeatured = index === 0 && project.data.highlight;

          return (
            <div class={isPrimaryFeatured ? 'lg:col-span-12' : 'lg:col-span-6'}>
              <ProjectCard
                project={project}
                locale={locale}
                isFeatured={project.data.highlight}
                class="h-full"
              />
            </div>
          );
        })}
      </div>
    ) : (
      <!-- Empty state fallback (graceful UI) -->
      <div class="rounded-xl border border-dashed border-border dark:border-border-dark p-12 text-center">
        <p class="text-sm font-mono text-muted dark:text-muted-dark">
          {locale === 'vi' ? 'Chưa có dự án nào được công bố.' : 'No projects available at this time.'}
        </p>
      </div>
    )}
  </div>
</section>
