---
import { defaultLang, type SupportedLanguage } from '../i18n/ui';
import { useTranslations, useTranslatedPath } from '../i18n/utils';

export interface Props {
  lang?: SupportedLanguage;
  title?: string;
  subtitle?: string;
  class?: string;
}

const {
  lang = defaultLang,
  title,
  subtitle,
  class: className = '',
} = Astro.props;

const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);

const sectionTitle = title || t('section.capabilities');
const sectionSubtitle = subtitle || (
  lang === 'vi'
    ? 'Năng lực kỹ thuật được phân nhóm rõ ràng, gắn liền trực tiếp với kết quả thực tế từ các dự án doanh nghiệp.'
    : 'Core engineering capabilities grounded in production deliverables and architectural proof points.'
);

interface ProofProject {
  name: string;
  slug?: string;
  role: string;
}

interface CapabilityDomain {
  id: string;
  title: string;
  description: string;
  icon: string;
  skills: string[];
  proofs: ProofProject[];
  colSpanClass: string;
}

const domains: CapabilityDomain[] = [
  {
    id: 'backend',
    title: lang === 'vi' ? 'Kiến trúc Backend & Nền tảng .NET' : 'Backend & .NET Architecture',
    description:
      lang === 'vi'
        ? 'Dịch vụ RESTful thông lượng cao, Clean Architecture, Domain-Driven Design (DDD), khóa đồng thời phân tán và truyền dẫn sự kiện thời gian thực.'
        : 'High-throughput RESTful services, Clean Architecture, Domain-Driven Design (DDD), distributed concurrency locks, and real-time event streaming.',
    icon: 'server',
    colSpanClass: 'md:col-span-1 lg:col-span-3',
    skills: [
      'C#',
      'ASP.NET Core 8',
      'Clean Architecture',
      'Domain-Driven Design (DDD)',
      'RESTful APIs',
      'SignalR',
      'Concurrency Locking',
      'Microservices',
    ],
    proofs: [
      {
        name: 'SEP490 (SLMS)',
        slug: 'sep490-construction-slms',
        role: lang === 'vi' ? 'Trưởng nhóm Backend (~340 commits, Clean Architecture)' : 'Backend Lead (~340 commits, Clean Architecture)',
      },
      {
        name: 'FIS (CodeLearn)',
        slug: 'codelearn-community-content',
        role: lang === 'vi' ? 'Backend phân hệ Diễn đàn Q&A & Blog' : 'Forum Q&A & Editorial Blog Backend',
      },
    ],
  },
  {
    id: 'ai-automation',
    title: lang === 'vi' ? 'Tác tử AI Doanh nghiệp & Tự động hóa' : 'Enterprise AI Agents & Automation',
    description:
      lang === 'vi'
        ? 'Hệ sinh thái đa tác nhân tự hành, trợ lý đàm thoại nghiệp vụ trên Mattermost, điều phối không máy chủ và tích hợp quy trình LLM bảo mật.'
        : 'Multi-agent autonomous systems, conversational business assistants on Mattermost, serverless dispatching, and secure LLM workflow integrations.',
    icon: 'bot',
    colSpanClass: 'md:col-span-1 lg:col-span-3',
    skills: [
      'Mattermost Bot API',
      'Autonomous Agents',
      'LLM Workflow Integration',
      'Task Dispatching',
      'Supabase Edge Functions (Deno)',
      'Prompt Engineering',
      'Webhook Pipelines',
    ],
    proofs: [
      {
        name: 'NAL Vietnam',
        slug: 'nal-ai-automation-erp',
        role: lang === 'vi' ? 'Hệ sinh thái 4 AI Bot Mattermost & Tự động hóa ERP' : '4-Bot Mattermost Ecosystem & ERP Automation',
      },
    ],
  },
  {
    id: 'frontend',
    title: lang === 'vi' ? 'Kỹ thuật Frontend Hiện đại' : 'Modern Frontend Engineering',
    description:
      lang === 'vi'
        ? 'Kiến trúc giao diện dựa trên component, truy xuất dữ liệu an toàn kiểu tĩnh, dashboard ERP quản trị và hệ thống thiết kế phản hồi.'
        : 'Component-driven architectures, type-safe data fetching, administrative ERP dashboards, and responsive design systems.',
    icon: 'layout',
    colSpanClass: 'md:col-span-1 lg:col-span-2',
    skills: [
      'React',
      'Next.js (App Router / ISR)',
      'Refine Framework',
      'Vue 3',
      'TypeScript',
      'Tailwind CSS',
      'Optimistic UI',
    ],
    proofs: [
      {
        name: 'NAL Vietnam ERP',
        slug: 'nal-ai-automation-erp',
        role: lang === 'vi' ? 'Refine & React Dashboard Quản trị' : 'Refine & React Admin Dashboard',
      },
      {
        name: 'FIS (CodeLearn)',
        slug: 'codelearn-community-content',
        role: lang === 'vi' ? 'Giao diện Diễn đàn & Blog Next.js' : 'Next.js Forum & Blog Frontend',
      },
    ],
  },
  {
    id: 'databases',
    title: lang === 'vi' ? 'Bộ nhớ đệm & Cơ sở Dữ liệu SQL' : 'Distributed Caching & SQL Databases',
    description:
      lang === 'vi'
        ? 'Mô hình hóa dữ liệu quan hệ, tối ưu hóa truy vấn, chiến lược cache-aside, vô hiệu hóa cache qua Pub/Sub và bảo mật cấp hàng (RLS).'
        : 'Relational data modeling, query optimization, cache-aside strategies, Pub/Sub cache invalidation, and Row-Level Security (RLS).',
    icon: 'database',
    colSpanClass: 'md:col-span-1 lg:col-span-2',
    skills: [
      'PostgreSQL',
      'SQL Server',
      'Entity Framework Core 7/8',
      'Redis Cache',
      'Redis Pub/Sub',
      'Supabase RLS',
      'Soft-Delete Query Filters',
    ],
    proofs: [
      {
        name: 'SEP490 (SLMS)',
        slug: 'sep490-construction-slms',
        role: lang === 'vi' ? 'Redis Distributed Cache & EF Core 7' : 'Redis Distributed Cache & EF Core 7',
      },
      {
        name: 'FIS (CodeLearn)',
        slug: 'codelearn-community-content',
        role: lang === 'vi' ? 'Kênh Vô hiệu hóa Cache Redis Pub/Sub' : 'Redis Pub/Sub Cache Invalidation',
      },
    ],
  },
  {
    id: 'devops',
    title: lang === 'vi' ? 'Kiểm thử & Tự động hóa DevOps' : 'Testing & DevOps Automation',
    description:
      lang === 'vi'
        ? 'Bộ kiểm thử đơn vị và tích hợp tự động, kiểm thử E2E trên trình duyệt, đóng gói container và quy trình triển khai tĩnh trên mạng biên.'
        : 'Automated unit and integration test suites, end-to-end browser testing, containerization, and static edge deployment pipelines.',
    icon: 'shield',
    colSpanClass: 'md:col-span-2 lg:col-span-2',
    skills: [
      'xUnit',
      'Moq',
      'FluentAssertions',
      'Playwright E2E',
      'Docker',
      'GitHub Actions CI/CD',
      'Cloudflare Pages',
      'Astro Static Engine',
    ],
    proofs: [
      {
        name: 'SEP490 CI/CD',
        slug: 'sep490-construction-slms',
        role: lang === 'vi' ? 'Docker & GitHub Actions Pipeline' : 'Docker & GitHub Actions Pipeline',
      },
      {
        name: 'Portfolio',
        role: lang === 'vi' ? 'Playwright E2E & Triển khai Cloudflare Pages' : 'Playwright E2E & Cloudflare Pages Edge',
      },
    ],
  },
];
---

<section
  id="capabilities"
  class={`scroll-mt-16 py-12 ${className}`}
  aria-labelledby="capabilities-heading"
>
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <!-- Section Header -->
    <div class="mb-10 sm:mb-12">
      <span class="text-xs font-mono font-medium text-accent uppercase tracking-widest block mb-2">
        {lang === 'vi' ? 'Năng lực cốt lõi' : 'Core Proficiencies'}
      </span>
      <h2
        id="capabilities-heading"
        class="text-2xl sm:text-3xl font-bold tracking-tight text-ink"
      >
        {sectionTitle}
      </h2>
      <p class="text-sm sm:text-base text-muted mt-2 max-w-2xl leading-relaxed">
        {sectionSubtitle}
      </p>
    </div>

    <!-- Capabilities Grid (6-column base on desktop, 2-column on tablet, 1-column on mobile) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-6 gap-6">
      {domains.map((domain) => (
        <div
          class={`${domain.colSpanClass} bg-surface border border-border rounded-lg p-5 sm:p-6 shadow-sm flex flex-col justify-between transition-all duration-200 hover:border-accent/40 hover:shadow-md group`}
        >
          <!-- Top Area: Icon, Title, Summary & Skills -->
          <div>
            <!-- Domain Icon & Title -->
            <div class="flex items-center gap-3 mb-3">
              <div class="w-9 h-9 rounded-md bg-accent/10 text-accent flex items-center justify-center shrink-0">
                {domain.icon === 'server' && (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <rect x="2" y="3" width="20" height="6" rx="2" stroke-linecap="round" stroke-linejoin="round" />
                    <rect x="2" y="15" width="20" height="6" rx="2" stroke-linecap="round" stroke-linejoin="round" />
                    <circle cx="6" cy="6" r="1" fill="currentColor" />
                    <circle cx="6" cy="18" r="1" fill="currentColor" />
                  </svg>
                )}
                {domain.icon === 'bot' && (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 3.104v1.834m4.5-1.834v1.834M4.5 9.75a3 3 0 013-3h9a3 3 0 013 3v8.25a3 3 0 01-3 3h-9a3 3 0 01-3-3V9.75z" />
                    <circle cx="9" cy="13" r="1" fill="currentColor" />
                    <circle cx="15" cy="13" r="1" fill="currentColor" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M10 17h4" />
                  </svg>
                )}
                {domain.icon === 'layout' && (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 5a1 1 0 011-1h14a1 1 0 011 1v14a1 1 0 01-1 1H5a1 1 0 01-1-1V5z" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M4 10h16M10 4v16" />
                  </svg>
                )}
                {domain.icon === 'database' && (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <ellipse cx="12" cy="5" rx="9" ry="3" stroke-linecap="round" stroke-linejoin="round" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M21 12c0 1.66-4 3-9 3s-9-1.34-9-3" />
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3 5v14c0 1.66 4 3 9 3s9-1.34 9-3V5" />
                  </svg>
                )}
                {domain.icon === 'shield' && (
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                  </svg>
                )}
              </div>
              <h3 class="text-base sm:text-lg font-semibold text-ink tracking-tight group-hover:text-accent transition-colors duration-150">
                {domain.title}
              </h3>
            </div>

            <!-- Domain Narrative Summary -->
            <p class="text-xs sm:text-sm text-muted leading-relaxed mb-4">
              {domain.description}
            </p>

            <!-- Technical Skills Wrapped Badges -->
            <div class="mb-5">
              <span class="text-[11px] font-mono font-medium text-ink/70 uppercase tracking-wider block mb-2">
                {lang === 'vi' ? 'Công nghệ & Kỹ thuật' : 'Technologies & Methods'}
              </span>
              <div class="flex flex-wrap gap-1.5 sm:gap-2">
                {domain.skills.map((skill) => (
                  <span class="inline-flex items-center px-2 py-0.5 rounded text-xs font-mono bg-canvas border border-border text-ink/85 break-words transition-colors group-hover:border-border/80">
                    {skill}
                  </span>
                ))}
              </div>
            </div>
          </div>

          <!-- Bottom Area: Proof Projects -->
          <div class="mt-2 pt-4 border-t border-border/60">
            <div class="text-[11px] font-mono font-medium text-accent uppercase tracking-wider mb-2 flex items-center gap-1.5">
              <svg class="w-3.5 h-3.5 text-accent shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" />
              </svg>
              <span>{lang === 'vi' ? 'Dự án Chứng minh' : 'Proof Projects'}</span>
            </div>

            <div class="space-y-1.5">
              {domain.proofs.map((proof) => (
                proof.slug ? (
                  <a
                    href={translatePath(`/projects/${proof.slug}`)}
                    class="group/proof flex items-start justify-between gap-2 p-2 rounded-md bg-canvas/60 hover:bg-canvas border border-border/50 hover:border-accent/40 transition-all text-xs"
                  >
                    <div class="min-w-0 flex-1">
                      <div class="font-medium text-ink group-hover/proof:text-accent transition-colors flex items-center gap-1 truncate">
                        <span>{proof.name}</span>
                        <svg class="w-3 h-3 text-muted group-hover/proof:text-accent group-hover/proof:translate-x-0.5 transition-all shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                          <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" />
                        </svg>
                      </div>
                      <div class="text-[11px] text-muted truncate mt-0.5 font-mono">
                        {proof.role}
                      </div>
                    </div>
                  </a>
                ) : (
                  <div class="flex items-start justify-between gap-2 p-2 rounded-md bg-canvas/60 border border-border/50 text-xs">
                    <div class="min-w-0 flex-1">
                      <div class="font-medium text-ink truncate">
                        {proof.name}
                      </div>
                      <div class="text-[11px] text-muted truncate mt-0.5 font-mono">
                        {proof.role}
                      </div>
                    </div>
                  </div>
                )
              ))}
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>
