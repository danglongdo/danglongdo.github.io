---
import siteConfig from '../config/site';
import { useTranslations, useTranslatedPath } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

export interface Props {
  lang?: SupportedLanguage;
  class?: string;
  as?: 'footer' | 'div';
}

const { lang = 'en', class: className = '', as: Tag = 'footer' } = Astro.props;
const t = useTranslations(lang);
const translatePath = useTranslatedPath(lang);
const currentYear = new Date().getFullYear();

const mailtoSubject = encodeURIComponent(siteConfig.contact.subject);
const mailtoUrl = `mailto:${siteConfig.contact.email}?subject=${mailtoSubject}`;

const navLinks = [
  { label: t('nav.projects'), href: translatePath('/#projects') },
  { label: t('nav.experience'), href: translatePath('/#experience') },
  { label: t('nav.capabilities'), href: translatePath('/#capabilities') },
  { label: t('nav.contact'), href: translatePath('/#contact') },
  { label: t('nav.resume'), href: siteConfig.links.resume, isDownload: true },
];
---

<Tag
  class:list={[
    'w-full border-t border-border dark:border-border-dark bg-surface dark:bg-surface-dark transition-colors',
    className,
  ]}
>
  <div class="max-w-5xl mx-auto px-6 py-12 md:py-16">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12">
      {/* Brand & positioning column */}
      <div class="md:col-span-6 space-y-3">
        <a
          href={translatePath('/')}
          class="inline-block text-lg font-bold tracking-tight text-ink dark:text-ink-dark hover:text-accent dark:hover:text-accent-dark transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-canvas rounded-md"
        >
          {siteConfig.name}
        </a>
        <p class="text-sm font-mono text-muted dark:text-muted-dark max-w-md leading-relaxed">
          {siteConfig.title}
        </p>
        <p class="text-xs text-muted dark:text-muted-dark">
          {lang === 'vi' ? 'Hà Nội, Việt Nam • Sẵn sàng làm việc từ xa & trực tiếp' : 'Hanoi, Vietnam • Open to remote & on-site roles'}
        </p>
      </div>

      {/* Navigation quick links */}
      <div class="md:col-span-3 space-y-3">
        <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-ink dark:text-ink-dark">
          {lang === 'vi' ? 'Liên kết nhanh' : 'Quick Links'}
        </h3>
        <ul class="space-y-2 text-sm" role="list">
          {
            navLinks.map((link) => (
              <li>
                <a
                  href={link.href}
                  download={link.isDownload ? true : undefined}
                  class="inline-block text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-canvas rounded px-1 -mx-1"
                >
                  {link.label}
                </a>
              </li>
            ))
          }
        </ul>
      </div>

      {/* Connect & channels */}
      <div class="md:col-span-3 space-y-3">
        <h3 class="text-xs font-mono font-semibold uppercase tracking-wider text-ink dark:text-ink-dark">
          {lang === 'vi' ? 'Kết nối' : 'Connect'}
        </h3>
        <ul class="space-y-2 text-sm" role="list">
          <li>
            <a
              href={mailtoUrl}
              class="inline-flex items-center gap-1.5 text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-canvas rounded px-1 -mx-1"
              aria-label={`${t('contact.email')}: ${siteConfig.contact.email}`}
            >
              <span>{t('contact.email')}</span>
            </a>
          </li>
          <li>
            <a
              href={siteConfig.links.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-canvas rounded px-1 -mx-1"
              aria-label="LinkedIn Profile (opens in a new tab)"
            >
              <span>{t('contact.linkedin')}</span>
              <svg
                class="w-3 h-3 opacity-60"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                />
              </svg>
            </a>
          </li>
          <li>
            <a
              href={siteConfig.links.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-1.5 text-muted dark:text-muted-dark hover:text-accent dark:hover:text-accent-dark transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-canvas rounded px-1 -mx-1"
              aria-label="GitHub Profile: lombeo (opens in a new tab)"
            >
              <span>{t('contact.github')}</span>
              <svg
                class="w-3 h-3 opacity-60"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                />
              </svg>
            </a>
          </li>
        </ul>
      </div>
    </div>

    {/* Bottom bar: Copyright, Hosting, and Build Attribution */}
    <div class="mt-12 pt-8 border-t border-border dark:border-border-dark flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-muted dark:text-muted-dark">
      {/* Copyright statement */}
      <p class="font-sans">
        &copy; {currentYear} {siteConfig.name}. {t('footer.rights')}
      </p>

      {/* Badges: Hosting and Tech Stack */}
      <div class="flex flex-wrap items-center gap-3">
        {/* Built with Astro & Tailwind badge */}
        <span class="font-mono text-[11px] text-muted dark:text-muted-dark">
          {t('footer.builtWith')}
        </span>

        <span class="text-border dark:text-border-dark" aria-hidden="true">•</span>

        {/* Cloudflare Pages Hosting Badge */}
        <a
          href="https://pages.cloudflare.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md border border-border dark:border-border-dark bg-canvas dark:bg-canvas-dark text-muted dark:text-muted-dark hover:text-ink dark:hover:text-ink-dark hover:border-accent/40 dark:hover:border-accent-dark/40 font-mono text-[11px] transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
          aria-label={`${t('footer.hostedOn')} (opens in a new tab)`}
        >
          <svg
            class="w-3.5 h-3.5 text-[#F38020]"
            viewBox="0 0 24 24"
            fill="currentColor"
            aria-hidden="true"
          >
            <path d="M19.35 10.04C18.67 6.59 15.64 4 12 4 9.11 4 6.6 5.64 5.35 8.04 2.34 8.36 0 10.91 0 14c0 3.31 2.69 6 6 6h13c2.76 0 5-2.24 5-5 0-2.64-2.05-4.78-4.65-4.96zM19 18H6c-2.21 0-4-1.79-4-4 0-2.05 1.53-3.76 3.56-3.97l1.07-.11.5-.95C8.08 7.14 9.94 6 12 6c2.62 0 4.88 1.86 5.39 4.43l.3 1.5 1.53.11c1.56.1 2.78 1.41 2.78 2.96 0 1.65-1.35 3-3 3z" />
          </svg>
          <span>{t('footer.hostedOn')}</span>
        </a>
      </div>
    </div>
  </div>
</Tag>
