---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import fs from 'node:fs';
import path from 'node:path';

export interface Props {
  src?: string | ImageMetadata;
  alt?: string;
  className?: string;
  size?: 'sm' | 'md' | 'lg';
}

const {
  src,
  alt,
  className = '',
  size = 'md',
} = Astro.props;

const defaultAlt = 'Portrait placeholder for Đỗ Đăng Long';
const effectiveAlt = alt || defaultAlt;

const sizeMap = {
  sm: {
    container: 'w-16 h-16',
    width: 64,
    height: 64,
    rounded: 'rounded-xl',
  },
  md: {
    container: 'w-32 h-32 sm:w-36 sm:h-36',
    width: 144,
    height: 144,
    rounded: 'rounded-2xl',
  },
  lg: {
    container: 'w-48 h-48 sm:w-56 sm:h-56',
    width: 224,
    height: 224,
    rounded: 'rounded-3xl',
  },
} as const;

const currentSize = sizeMap[size] || sizeMap.md;

// Check if image exists on disk
let imageSource: ImageMetadata | string | null = null;
let hasImage = false;

// Eagerly match images in src if any exist
const localImages = import.meta.glob<{ default: ImageMetadata }>(
  '/src/**/*.{jpeg,jpg,png,tiff,webp,gif,avif}',
  { eager: true }
);

// If src not provided, check standard portrait paths
let targetSrc = src;
if (!targetSrc) {
  const cwd = process.cwd();
  if (fs.existsSync(path.join(cwd, 'src/assets/portrait.png'))) {
    targetSrc = '/src/assets/portrait.png';
  } else if (fs.existsSync(path.join(cwd, 'public/images/portrait.png'))) {
    targetSrc = '/images/portrait.png';
  } else if (fs.existsSync(path.join(cwd, 'public/images/portrait.jpg'))) {
    targetSrc = '/images/portrait.jpg';
  }
}

if (targetSrc) {
  if (typeof targetSrc === 'object' && targetSrc !== null && 'src' in targetSrc) {
    imageSource = targetSrc;
    hasImage = true;
  } else if (typeof targetSrc === 'string' && targetSrc.trim() !== '') {
    const trimmed = targetSrc.trim();
    const cwd = process.cwd();

    // Check possible on-disk paths
    const candidates: { diskPath: string; webPath?: string }[] = [];

    if (path.isAbsolute(trimmed)) {
      if (fs.existsSync(trimmed)) {
        candidates.push({ diskPath: trimmed });
      }
      const inPublic = path.join(cwd, 'public', trimmed.replace(/^\//, ''));
      candidates.push({ diskPath: inPublic, webPath: trimmed });

      const inRoot = path.join(cwd, trimmed.replace(/^\//, ''));
      candidates.push({ diskPath: inRoot });
    } else {
      if (trimmed.startsWith('@/')) {
        const inSrc = path.join(cwd, 'src', trimmed.slice(2));
        candidates.push({ diskPath: inSrc });
      }
      const inPublic = path.join(cwd, 'public', trimmed);
      candidates.push({ diskPath: inPublic, webPath: '/' + trimmed });

      const fromCwd = path.resolve(cwd, trimmed);
      candidates.push({ diskPath: fromCwd });
    }

    for (const c of candidates) {
      try {
        if (fs.existsSync(c.diskPath) && fs.statSync(c.diskPath).isFile()) {
          const relativeToCwd = '/' + path.relative(cwd, c.diskPath).replace(/\\/g, '/');
          const globMatch = localImages[relativeToCwd];

          if (globMatch?.default) {
            imageSource = globMatch.default;
            hasImage = true;
            break;
          } else if (c.webPath) {
            imageSource = c.webPath;
            hasImage = true;
            break;
          } else if (c.diskPath.startsWith(path.join(cwd, 'public'))) {
            imageSource = '/' + path.relative(path.join(cwd, 'public'), c.diskPath).replace(/\\/g, '/');
            hasImage = true;
            break;
          }
        }
      } catch {
        // Fallback continues
      }
    }
  }
}
---

<div
  class:list={[
    'group relative inline-flex items-center justify-center overflow-hidden shrink-0 select-none',
    currentSize.container,
    currentSize.rounded,
    'bg-surface dark:bg-surface-dark',
    'ring-1 ring-border dark:ring-border-dark shadow-sm',
    className,
  ]}
>
  {hasImage && imageSource ? (
    <Image
      src={imageSource}
      alt={effectiveAlt}
      format="webp"
      width={currentSize.width}
      height={currentSize.height}
      class:list={[
        'w-full h-full object-cover object-center',
        currentSize.rounded,
      ]}
    />
  ) : (
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 400 400"
      width="100%"
      height="100%"
      fill="none"
      role="img"
      aria-label={effectiveAlt}
      class:list={['w-full h-full', currentSize.rounded]}
    >
      <title>{effectiveAlt}</title>
      <desc>Sophisticated editorial monogram featuring initials DL for Đỗ Đăng Long</desc>
      <defs>
        <linearGradient id="portrait-slate-bg" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#1B1E22" />
          <stop offset="50%" stop-color="#14171A" />
          <stop offset="100%" stop-color="#0E1012" />
        </linearGradient>
        <linearGradient id="portrait-cobalt-accent" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#4E8CFF" />
          <stop offset="100%" stop-color="#2457D6" />
        </linearGradient>
        <linearGradient id="portrait-border-grad" x1="0%" y1="0%" x2="100%" y2="100%">
          <stop offset="0%" stop-color="#2457D6" stop-opacity="0.9" />
          <stop offset="40%" stop-color="#303840" stop-opacity="0.6" />
          <stop offset="100%" stop-color="#2457D6" stop-opacity="0.4" />
        </linearGradient>
        <radialGradient id="portrait-ambient-glow" cx="70%" cy="30%" r="60%">
          <stop offset="0%" stop-color="#2457D6" stop-opacity="0.22" />
          <stop offset="60%" stop-color="#2457D6" stop-opacity="0.04" />
          <stop offset="100%" stop-color="#2457D6" stop-opacity="0" />
        </radialGradient>
        <pattern id="portrait-dot-grid" x="0" y="0" width="20" height="20" patternUnits="userSpaceOnUse">
          <circle cx="2" cy="2" r="1" fill="#FFFFFF" fill-opacity="0.05" />
        </pattern>
      </defs>

      <!-- Background Base -->
      <rect x="2" y="2" width="396" height="396" rx="44" fill="url(#portrait-slate-bg)" />
      
      <!-- Subtle Dot Grid Matrix -->
      <rect x="2" y="2" width="396" height="396" rx="44" fill="url(#portrait-dot-grid)" />

      <!-- Ambient Cobalt Glow -->
      <rect x="2" y="2" width="396" height="396" rx="44" fill="url(#portrait-ambient-glow)" />

      <!-- Outer Editorial Border Ring -->
      <rect x="2" y="2" width="396" height="396" rx="44" stroke="url(#portrait-border-grad)" stroke-width="2" />

      <!-- Inner Subtle Hairline Guide -->
      <rect x="14" y="14" width="372" height="372" rx="34" stroke="#D9DDE1" stroke-opacity="0.08" stroke-width="1" />

      <!-- Editorial Corner Marks -->
      <path d="M 28 40 L 28 28 L 40 28" stroke="#2457D6" stroke-width="1.5" stroke-linecap="round" />
      <path d="M 372 40 L 372 28 L 360 28" stroke="#2457D6" stroke-width="1.5" stroke-linecap="round" />
      <path d="M 28 360 L 28 372 L 40 372" stroke="#2457D6" stroke-width="1.5" stroke-linecap="round" />
      <path d="M 372 360 L 372 372 L 360 372" stroke="#2457D6" stroke-width="1.5" stroke-linecap="round" />

      <!-- Architectural Header Meta (hidden on small) -->
      <g opacity="0.8" class={size === 'sm' ? 'hidden' : ''}>
        <text x="200" y="76" text-anchor="middle" fill="#4E8CFF" font-family="'Geist Mono', 'JetBrains Mono', monospace" font-size="11" font-weight="600" letter-spacing="0.28em">PORTFOLIO // PROFILE</text>
      </g>

      <!-- Geometric Monogram "DL" -->
      <g transform="translate(0, 0)">
        <!-- Letter "D" in Crisp Architectural White -->
        <path
          d="M 116 142 H 168 C 196 142 214 160 214 198 C 214 236 196 254 168 254 H 116 Z M 138 164 V 232 H 166 C 182 232 192 222 192 198 C 192 174 182 164 166 164 Z"
          fill="#F7F7F4"
          fill-rule="evenodd"
        />

        <!-- Letter "L" in Duotone Cobalt Gradient -->
        <path
          d="M 226 142 H 248 V 232 H 286 V 254 H 226 Z"
          fill="url(#portrait-cobalt-accent)"
        />

        <!-- Modernist Accent Dot -->
        <circle cx="280" cy="150" r="5" fill="#4E8CFF" />
      </g>

      <!-- Editorial Footer Meta (hidden on small) -->
      <g opacity="0.75" class={size === 'sm' ? 'hidden' : ''}>
        <text x="200" y="318" text-anchor="middle" fill="#D9DDE1" font-family="'Geist Sans', 'Inter', -apple-system, sans-serif" font-size="13" font-weight="600" letter-spacing="0.22em">ĐỖ ĐĂNG LONG</text>
        <text x="200" y="338" text-anchor="middle" fill="#5C6570" font-family="'Geist Mono', 'JetBrains Mono', monospace" font-size="10" font-weight="500" letter-spacing="0.16em">SYS · ARCHITECT // SWE</text>
      </g>
    </svg>
  )}
</div>
