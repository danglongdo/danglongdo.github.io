---
import type { CollectionEntry } from 'astro:content';
import type { ProjectFrontmatter } from '../content.config';
import type { SupportedLanguage } from '../i18n/ui';
import { useTranslations, useTranslatedPath } from '../i18n/utils';

export interface Props {
  project?: CollectionEntry<'projects'> | ProjectFrontmatter;
  title?: string;
  slug?: string;
  locale?: SupportedLanguage;
  summary?: string;
  role?: string;
  timeline?: string;
  techStack?: string[];
  highlight?: boolean;
  securityNotice?: string;
  challenge?: string;
  approach?: string;
  category?: string;
  isFeatured?: boolean;
  class?: string;
}

const {
  project,
  title: propTitle,
  slug: propSlug,
  locale: propLocale,
  summary: propSummary,
  role: propRole,
  timeline: propTimeline,
  techStack: propTechStack,
  highlight: propHighlight,
  securityNotice: propSecurityNotice,
  challenge: propChallenge,
  approach: propApproach,
  category: propCategory,
  isFeatured: propIsFeatured,
  class: className = '',
} = Astro.props;

// Extract frontmatter if passed as collection entry or frontmatter object
const data: Partial<ProjectFrontmatter> = project
  ? 'data' in project
    ? project.data
    : project
  : {};

const title = propTitle ?? data.title ?? '';
const slug = propSlug ?? data.slug ?? '';
const locale = (propLocale ?? data.locale ?? 'en') as SupportedLanguage;
const summary = propSummary ?? data.summary ?? '';
const role = propRole ?? data.role ?? '';
const timeline = propTimeline ?? data.timeline ?? '';
const techStack = propTechStack ?? data.techStack;
const highlight = propHighlight ?? propIsFeatured ?? data.highlight ?? false;
const securityNotice = propSecurityNotice ?? data.securityNotice;
const challenge = propChallenge ?? data.challenge ?? '';
const approach = propApproach ?? data.approach ?? '';

const categoryMap: Record<string, { en: string; vi: string }> = {
  'nal-ai-automation-erp': {
    en: 'Enterprise AI & Internal ERP',
    vi: 'AI Doanh nghiệp & ERP Nội bộ',
  },
  'sep490-construction-slms': {
    en: 'Distributed Systems & .NET',
    vi: 'Hệ thống Phân tán & .NET',
  },
  'codelearn-community-content': {
    en: 'High-Traffic Web & Microservices',
    vi: 'Hệ thống Web & Microservices',
  },
};

const defaultCategory = locale === 'vi' ? 'Hệ thống Doanh nghiệp' : 'Enterprise Systems';
const category = propCategory || (slug in categoryMap ? categoryMap[slug][locale] : defaultCategory);

const t = useTranslations(locale);
const translatePath = useTranslatedPath(locale);
const projectUrl = translatePath(`/projects/${slug}`);

// One-sentence problem statement preference: challenge first, then summary
const problemStatement = challenge || summary;
---

<article
  class:list={[
    'group relative flex flex-col justify-between bg-surface dark:bg-surface-dark border rounded-xl p-6 md:p-8 transition-colors duration-150 shadow-sm hover:shadow-md',
    highlight
      ? 'border-accent/40 dark:border-accent-dark/40 ring-1 ring-accent/15 dark:ring-accent-dark/20 hover:border-accent dark:hover:border-accent-dark'
      : 'border-border dark:border-border-dark hover:border-accent dark:hover:border-accent-dark',
    className,
  ]}
>
  <div class="space-y-4">
    <!-- Header badges: Category, Featured status, Security Notice -->
    <div class="flex flex-wrap items-center justify-between gap-2">
      <div class="flex flex-wrap items-center gap-2">
        <span class="inline-flex items-center px-2.5 py-0.5 rounded text-xs font-mono font-medium bg-canvas dark:bg-canvas-dark text-muted dark:text-muted-dark border border-border dark:border-border-dark">
          {category}
        </span>

        {highlight && (
          <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-medium bg-accent/10 text-accent dark:bg-accent-dark/15 dark:text-accent-dark border border-accent/20 dark:border-accent-dark/30">
            <span class="w-1.5 h-1.5 rounded-full bg-accent dark:bg-accent-dark" aria-hidden="true" />
            {t('project.featured')}
          </span>
        )}
      </div>

      {securityNotice && (
        <span
          class="inline-flex items-center gap-1 px-2 py-0.5 rounded text-[11px] font-mono text-muted dark:text-muted-dark bg-canvas dark:bg-canvas-dark border border-border dark:border-border-dark"
          title={securityNotice}
        >
          <svg
            class="w-3 h-3 text-muted dark:text-muted-dark shrink-0"
            fill="none"
            viewBox="0 0 24 24"
            stroke="currentColor"
            stroke-width="2"
            aria-hidden="true"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"
            />
          </svg>
          <span>{t('project.confidential')}</span>
        </span>
      )}
    </div>

    <!-- Title -->
    <div>
      <h3 class="text-xl md:text-2xl font-bold tracking-tight text-ink dark:text-ink-dark">
        <a
          href={projectUrl}
          class="hover:text-accent dark:hover:text-accent-dark focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent dark:focus-visible:ring-accent-dark focus-visible:ring-offset-2 rounded-sm transition-colors duration-150"
        >
          {title}
        </a>
      </h3>

      {role && (
        <div class="mt-2 flex items-center gap-1.5 text-xs font-mono text-muted dark:text-muted-dark">
          <span class="font-semibold text-ink dark:text-ink-dark uppercase tracking-wider">{t('project.role')}:</span>
          <span>{role}</span>
        </div>
      )}
    </div>

    <!-- One-sentence Problem Statement -->
    {problemStatement && (
      <p class="text-sm md:text-base text-muted dark:text-muted-dark leading-relaxed">
        {problemStatement}
      </p>
    )}

    <!-- Key Architectural Decision -->
    {approach && (
      <div class="rounded-lg bg-canvas/60 dark:bg-canvas-dark/60 border border-border/70 dark:border-border-dark/70 p-3.5 text-xs leading-relaxed">
        <span class="font-mono font-semibold text-ink dark:text-ink-dark block mb-1">
          {t('project.keyDecision')}:
        </span>
        <span class="text-muted dark:text-muted-dark line-clamp-3">
          {approach}
        </span>
      </div>
    )}

    <!-- Tech Stack Pill Badges (QA Failure Scenario: Missing or empty tech stack renders nothing) -->
    {Array.isArray(techStack) && techStack.length > 0 && (
      <div class="flex flex-wrap gap-1.5 pt-1" aria-label={t('project.techStack')}>
        {techStack.map((tech) => (
          <span class="inline-flex items-center px-2 py-0.5 rounded font-mono text-xs bg-canvas dark:bg-canvas-dark text-muted dark:text-muted-dark border border-border dark:border-border-dark">
            {tech}
          </span>
        ))}
      </div>
    )}
  </div>

  <!-- Footer Action: Read Case Study Link & Timeline -->
  <div class="pt-5 mt-6 border-t border-border/60 dark:border-border-dark/60 flex items-center justify-between gap-4">
    <a
      href={projectUrl}
      class="group/link inline-flex items-center gap-1.5 text-sm font-semibold text-accent dark:text-accent-dark hover:text-accent-hover dark:hover:text-accent-dark-hover focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-accent dark:focus-visible:ring-accent-dark focus-visible:ring-offset-2 rounded transition-colors duration-150"
      aria-label={`${t('project.readCaseStudy')}: ${title}`}
    >
      <span>{t('project.readCaseStudy')}</span>
      <span
        class="inline-block transition-transform duration-150 group-hover/link:translate-x-1"
        aria-hidden="true"
      >
        &rarr;
      </span>
    </a>

    {timeline && (
      <span class="text-xs font-mono text-muted dark:text-muted-dark shrink-0">
        {timeline}
      </span>
    )}
  </div>
</article>
