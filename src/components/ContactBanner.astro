---
import siteConfig from '../config/site';
import { useTranslations } from '../i18n/utils';
import type { SupportedLanguage } from '../i18n/ui';

export interface Props {
  lang?: SupportedLanguage;
  class?: string;
}

const { lang = 'en', class: className = '' } = Astro.props;
const t = useTranslations(lang);

const mailtoSubject = encodeURIComponent(siteConfig.contact.subject);
const mailtoUrl = `mailto:${siteConfig.contact.email}?subject=${mailtoSubject}`;
---

<section
  id="contact"
  aria-labelledby="contact-heading"
  class:list={['py-12 md:py-20', className]}
>
  <div class="max-w-5xl mx-auto px-6">
    <div
      class="relative overflow-hidden rounded-2xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-8 md:p-12 shadow-sm"
    >
      {/* Decorative ambient background accent */}
      <div
        class="absolute -top-24 -right-24 w-96 h-96 bg-accent/5 dark:bg-accent-dark/10 rounded-full blur-3xl pointer-events-none"
        aria-hidden="true"
      ></div>

      <div class="relative z-10">
        {/* Status indicator & section badge */}
        <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
          <span class="text-xs font-mono font-semibold uppercase tracking-wider text-accent dark:text-accent-dark">
            {t('section.contact')}
          </span>

          {/* Open to Work status pulse indicator */}
          <div
            class="inline-flex items-center gap-2 px-3 py-1 rounded-full text-xs font-mono font-medium bg-emerald-500/10 text-emerald-800 dark:text-emerald-300 border border-emerald-500/20"
            role="status"
            aria-label={t('contact.openToWork')}
          >
            <span class="relative flex h-2 w-2" aria-hidden="true">
              <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-emerald-400 opacity-75"></span>
              <span class="relative inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            </span>
            <span>{t('contact.openToWork')}</span>
          </div>
        </div>

        {/* Section title & description */}
        <h2
          id="contact-heading"
          class="text-2xl md:text-3xl lg:text-4xl font-bold tracking-tight text-ink dark:text-ink-dark max-w-2xl"
        >
          {t('section.contact')}
        </h2>

        <p class="mt-4 text-base md:text-lg text-muted dark:text-muted-dark leading-relaxed max-w-2xl">
          {t('contact.subtitle')}
        </p>

        {/* Action channels & links */}
        <div class="mt-8 flex flex-wrap items-center gap-4">
          {/* Primary CTA: Direct Email Link */}
          <a
            href={mailtoUrl}
            class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-accent hover:bg-accent-hover dark:bg-accent-dark dark:hover:bg-accent-dark-hover text-white font-medium text-sm md:text-base shadow-sm hover:shadow transition-all duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
            aria-label={`${t('contact.sendEmail')}: ${siteConfig.contact.email}`}
          >
            <svg
              class="w-5 h-5"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"
              />
            </svg>
            <span>{siteConfig.contact.email}</span>
          </a>

          {/* Secondary CTA: Download CV */}
          <a
            href={siteConfig.links.resume}
            download
            class="inline-flex items-center justify-center gap-2 px-5 py-3.5 rounded-xl border border-border dark:border-border-dark bg-canvas dark:bg-canvas-dark hover:bg-surface dark:hover:bg-surface-dark text-ink dark:text-ink-dark font-medium text-sm transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
            aria-label={t('contact.downloadCv')}
          >
            <svg
              class="w-4 h-4 text-muted dark:text-muted-dark"
              fill="none"
              stroke="currentColor"
              viewBox="0 0 24 24"
              aria-hidden="true"
            >
              <path
                stroke-linecap="round"
                stroke-linejoin="round"
                stroke-width="2"
                d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"
              />
            </svg>
            <span>{t('contact.downloadCv')}</span>
          </a>

          {/* Social Profiles: LinkedIn & GitHub */}
          <div class="flex items-center gap-3">
            <a
              href={siteConfig.links.linkedin}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-3.5 rounded-xl border border-border dark:border-border-dark bg-canvas dark:bg-canvas-dark hover:bg-surface dark:hover:bg-surface-dark text-ink dark:text-ink-dark font-medium text-sm transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
              aria-label="LinkedIn Profile (opens in a new tab)"
            >
              <svg
                class="w-4 h-4 text-muted dark:text-muted-dark"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path d="M19 3a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h14m-.5 15.5v-5.3a3.26 3.26 0 0 0-3.26-3.26c-.85 0-1.84.52-2.28 1.3v-1.11h-2.79v8.37h2.79v-4.93c0-.77.62-1.4 1.39-1.4a1.4 1.4 0 0 1 1.4 1.4v4.93h2.75M6.46 10.9v8.37H9.2V10.9H6.46M7.83 6.45a1.6 1.6 0 0 0-1.6 1.6 1.6 1.6 0 0 0 1.6 1.6 1.6 1.6 0 0 0 1.6-1.6 1.6 1.6 0 0 0-1.6-1.6Z" />
              </svg>
              <span>{t('contact.linkedin')}</span>
              <svg
                class="w-3.5 h-3.5 text-muted dark:text-muted-dark opacity-70"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                />
              </svg>
            </a>

            <a
              href={siteConfig.links.github}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center gap-2 px-4 py-3.5 rounded-xl border border-border dark:border-border-dark bg-canvas dark:bg-canvas-dark hover:bg-surface dark:hover:bg-surface-dark text-ink dark:text-ink-dark font-medium text-sm transition-colors duration-150 focus:outline-none focus-visible:ring-2 focus-visible:ring-accent focus-visible:ring-offset-2 focus-visible:ring-offset-canvas"
              aria-label="GitHub Profile: lombeo (opens in a new tab)"
            >
              <svg
                class="w-4 h-4 text-muted dark:text-muted-dark"
                fill="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  clip-rule="evenodd"
                  d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.53 1.032 1.53 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
                />
              </svg>
              <span>{t('contact.github')}</span>
              <svg
                class="w-3.5 h-3.5 text-muted dark:text-muted-dark opacity-70"
                fill="none"
                stroke="currentColor"
                viewBox="0 0 24 24"
                aria-hidden="true"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"
                />
              </svg>
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
