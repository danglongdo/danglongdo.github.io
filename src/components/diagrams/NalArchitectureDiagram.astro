---
import type { SupportedLanguage } from '../../i18n/ui';

export interface Props {
  locale?: SupportedLanguage;
}

const { locale = 'en' } = Astro.props;
const isVi = locale === 'vi';
---

<div class="not-prose my-8 w-full rounded-2xl border border-border/80 dark:border-border-dark/80 bg-surface/90 dark:bg-surface-dark/90 p-5 sm:p-7 md:p-8 shadow-xs backdrop-blur-xs transition-colors">
  <!-- Diagram Header -->
  <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3 pb-6 border-b border-border/70 dark:border-border-dark/70">
    <div class="space-y-1">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center gap-1.5 px-2.5 py-0.5 rounded-full text-xs font-mono font-medium bg-accent/10 text-accent dark:bg-accent-dark/15 dark:text-accent-dark border border-accent/20 dark:border-accent-dark/30">
          <span class="relative flex h-2 w-2">
            <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-accent dark:bg-accent-dark opacity-75"></span>
            <span class="relative inline-flex rounded-full h-2 w-2 bg-accent dark:bg-accent-dark"></span>
          </span>
          <span>{isVi ? 'Kiến trúc Phân tầng' : 'Layered Architecture'}</span>
        </span>
        <span class="text-xs font-mono text-muted dark:text-muted-dark">
          Mattermost &bull; Supabase Edge &bull; PostgreSQL &bull; Refine
        </span>
      </div>
      <h3 class="text-base sm:text-lg font-bold text-ink dark:text-ink-dark tracking-tight">
        {isVi ? 'Sơ đồ Kiến trúc Hệ sinh thái AI & ERP Nội bộ' : 'AI Agent Ecosystem & Internal ERP System Topology'}
      </h3>
    </div>
    <div class="flex items-center gap-2 self-start sm:self-auto text-xs font-mono text-muted dark:text-muted-dark">
      <span class="px-2 py-1 rounded bg-canvas dark:bg-canvas-dark border border-border dark:border-border-dark">
        {isVi ? 'Chế độ: Đã kiểm toán' : 'Status: Production Audited'}
      </span>
    </div>
  </div>

  <!-- Diagram Canvas -->
  <div class="mt-8 space-y-6">
    <!-- LAYER 1: CLIENT LAYER (MATTERMOST) -->
    <div class="rounded-xl border border-border/70 dark:border-border-dark/70 bg-canvas/40 dark:bg-canvas-dark/40 p-4 sm:p-5">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-sm bg-accent dark:bg-accent-dark"></span>
          <h4 class="text-xs sm:text-sm font-mono font-semibold uppercase tracking-wider text-ink dark:text-ink-dark">
            {isVi ? 'Tầng Giao diện / Không gian Làm việc Mattermost' : 'Client Layer / Mattermost Enterprise Workspace'}
          </h4>
        </div>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-accent/10 text-accent dark:bg-accent-dark/20 dark:text-accent-dark border border-accent/20">
          {isVi ? '4 Tác tử Hội thoại Chuyên biệt' : '4 Dedicated Autonomous Agents'}
        </span>
      </div>

      <!-- 4 Agents Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3 sm:gap-4">
        <!-- Agent 1: Recruitment -->
        <div class="rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-3.5 sm:p-4 flex flex-col justify-between hover:border-accent/40 dark:hover:border-accent-dark/40 transition-colors">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="p-1.5 rounded-lg bg-blue-500/10 text-blue-600 dark:text-blue-400">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15.75 6a3.75 3.75 0 1 1-7.5 0 3.75 3.75 0 0 1 7.5 0ZM4.501 20.118a7.5 7.5 0 0 1 14.998 0A17.933 17.933 0 0 1 12 21.75c-2.676 0-5.216-.584-7.499-1.632Z" />
                </svg>
              </span>
              <span class="text-[10px] font-mono font-medium px-1.5 py-0.5 rounded bg-blue-500/10 text-blue-700 dark:text-blue-300">
                /recruit
              </span>
            </div>
            <h5 class="text-xs sm:text-sm font-semibold text-ink dark:text-ink-dark">
              {isVi ? 'Bot Tuyển dụng' : 'Recruitment Assistant'}
            </h5>
            <p class="text-[11px] sm:text-xs text-muted dark:text-muted-dark mt-1 leading-relaxed">
              {isVi ? 'Trích xuất hồ sơ CV, sinh bộ tiêu chí phỏng vấn & cập nhật trạng thái ứng viên' : 'CV parsing, interview rubric generation & candidate pipeline stage updates'}
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-border/60 dark:border-border-dark/60 flex flex-wrap gap-1">
            <span class="text-[10px] font-mono text-muted dark:text-muted-dark">CV JSON</span>
            <span class="text-[10px] font-mono text-muted dark:text-muted-dark">&bull;</span>
            <span class="text-[10px] font-mono text-muted dark:text-muted-dark">Rubric Gen</span>
          </div>
        </div>

        <!-- Agent 2: Policy Q&A -->
        <div class="rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-3.5 sm:p-4 flex flex-col justify-between hover:border-emerald-500/40 dark:hover:border-emerald-400/40 transition-colors">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="p-1.5 rounded-lg bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 6.042A8.967 8.967 0 0 0 6 3.75c-1.052 0-2.062.18-3 .512v14.25A8.987 8.987 0 0 1 6 18c2.305 0 4.408.867 6 2.292m0-14.25a8.966 8.966 0 0 1 6-2.292c1.052 0 2.062.18 3 .512v14.25A8.987 8.987 0 0 0 18 18a8.967 8.967 0 0 0-6 2.292m0-14.25v14.25" />
                </svg>
              </span>
              <span class="text-[10px] font-mono font-medium px-1.5 py-0.5 rounded bg-emerald-500/10 text-emerald-700 dark:text-emerald-300">
                /policy
              </span>
            </div>
            <h5 class="text-xs sm:text-sm font-semibold text-ink dark:text-ink-dark">
              {isVi ? 'Bot Hỏi đáp Quy chế' : 'Policy & Regulations Q&A'}
            </h5>
            <p class="text-[11px] sm:text-xs text-muted dark:text-muted-dark mt-1 leading-relaxed">
              {isVi ? 'Tra cứu tri thức RAG trên sổ tay nhân viên kèm dẫn chiếu điều khoản chính xác' : 'RAG vector knowledge retrieval across employee handbooks with explicit citations'}
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-border/60 dark:border-border-dark/60 flex flex-wrap gap-1">
            <span class="text-[10px] font-mono text-muted dark:text-muted-dark">RAG Vector</span>
            <span class="text-[10px] font-mono text-muted dark:text-muted-dark">&bull;</span>
            <span class="text-[10px] font-mono text-muted dark:text-muted-dark">Citations</span>
          </div>
        </div>

        <!-- Agent 3: Feedback Router -->
        <div class="rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-3.5 sm:p-4 flex flex-col justify-between hover:border-amber-500/40 dark:hover:border-amber-400/40 transition-colors">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="p-1.5 rounded-lg bg-amber-500/10 text-amber-600 dark:text-amber-400">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 8.25h9m-9 3H12m-9.75 1.51c0 1.6 1.123 2.994 2.707 3.227 1.129.166 2.27.293 3.423.379.35.026.67.21.865.501L12 21l2.755-4.133a1.14 1.14 0 0 1 .865-.502 49.188 49.188 0 0 0 3.423-.379c1.584-.233 2.707-1.626 2.707-3.228V6.741c0-1.602-1.123-2.995-2.707-3.228A48.394 48.394 0 0 0 12 3c-2.392 0-4.744.175-7.043.513C3.373 3.746 2.25 5.14 2.25 6.741v6.018Z" />
                </svg>
              </span>
              <span class="text-[10px] font-mono font-medium px-1.5 py-0.5 rounded bg-amber-500/10 text-amber-700 dark:text-amber-300">
                /feedback
              </span>
            </div>
            <h5 class="text-xs sm:text-sm font-semibold text-ink dark:text-ink-dark">
              {isVi ? 'Bot Điều phối Góp ý' : 'Employee Feedback Router'}
            </h5>
            <p class="text-[11px] sm:text-xs text-muted dark:text-muted-dark mt-1 leading-relaxed">
              {isVi ? 'Phân tích cảm xúc, cấu trúc hoá kiến nghị & chuyển tiếp kênh quản lý liên quan' : 'Sentiment analysis, structured categorization & automated routing to department leads'}
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-border/60 dark:border-border-dark/60 flex flex-wrap gap-1">
            <span class="text-[10px] font-mono text-muted dark:text-muted-dark">Sentiment</span>
            <span class="text-[10px] font-mono text-muted dark:text-muted-dark">&bull;</span>
            <span class="text-[10px] font-mono text-muted dark:text-muted-dark">Lead Alert</span>
          </div>
        </div>

        <!-- Agent 4: Meeting Scheduler -->
        <div class="rounded-xl border border-border dark:border-border-dark bg-surface dark:bg-surface-dark p-3.5 sm:p-4 flex flex-col justify-between hover:border-violet-500/40 dark:hover:border-violet-400/40 transition-colors">
          <div>
            <div class="flex items-center justify-between gap-2 mb-2">
              <span class="p-1.5 rounded-lg bg-violet-500/10 text-violet-600 dark:text-violet-400">
                <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
                </svg>
              </span>
              <span class="text-[10px] font-mono font-medium px-1.5 py-0.5 rounded bg-violet-500/10 text-violet-700 dark:text-violet-300">
                /schedule
              </span>
            </div>
            <h5 class="text-xs sm:text-sm font-semibold text-ink dark:text-ink-dark">
              {isVi ? 'Bot Sắp xếp Lịch họp' : 'Automated Meeting Scheduler'}
            </h5>
            <p class="text-[11px] sm:text-xs text-muted dark:text-muted-dark mt-1 leading-relaxed">
              {isVi ? 'Đối soát ma trận lịch trống đa thành viên, đề xuất khung giờ & tạo thư mời tự động' : 'Multi-attendee availability matrix intersection, slot ranking & calendar invitation dispatch'}
            </p>
          </div>
          <div class="mt-3 pt-2 border-t border-border/60 dark:border-border-dark/60 flex flex-wrap gap-1">
            <span class="text-[10px] font-mono text-muted dark:text-muted-dark">Free/Busy</span>
            <span class="text-[10px] font-mono text-muted dark:text-muted-dark">&bull;</span>
            <span class="text-[10px] font-mono text-muted dark:text-muted-dark">Calendar Sync</span>
          </div>
        </div>
      </div>
    </div>

    <!-- CONNECTOR ARROW 1: CLIENT -> EDGE -->
    <div class="flex flex-col items-center justify-center my-1 text-center">
      <div class="h-4 w-px bg-accent/40 dark:bg-accent-dark/40"></div>
      <div class="inline-flex items-center gap-2 px-3 py-1 rounded-full bg-canvas dark:bg-canvas-dark border border-border dark:border-border-dark text-[11px] font-mono text-muted dark:text-muted-dark shadow-xs">
        <svg class="w-3.5 h-3.5 text-accent dark:text-accent-dark animate-pulse" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
        </svg>
        <span>
          {isVi
            ? 'Webhooks Tương tác & Slash Events (Xác thực Ký số HMAC-SHA256)'
            : 'Interactive Webhooks & Slash Events (HMAC-SHA256 Signed)'}
        </span>
      </div>
      <div class="h-4 w-px bg-accent/40 dark:bg-accent-dark/40"></div>
    </div>

    <!-- LAYER 2: INTEGRATION & EDGE FUNCTIONS LAYER -->
    <div class="rounded-xl border border-accent/30 dark:border-accent-dark/30 bg-accent/5 dark:bg-accent-dark/5 p-4 sm:p-5">
      <div class="flex flex-wrap items-center justify-between gap-2 mb-4">
        <div class="flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-sm bg-accent dark:bg-accent-dark"></span>
          <h4 class="text-xs sm:text-sm font-mono font-semibold uppercase tracking-wider text-ink dark:text-ink-dark">
            {isVi ? 'Tầng Điều phối & Biên Serverless / Supabase Edge Functions' : 'Integration & Edge Layer / Supabase Edge Functions (Deno Runtime)'}
          </h4>
        </div>
        <span class="text-[11px] font-mono px-2 py-0.5 rounded-full bg-surface dark:bg-surface-dark border border-border dark:border-border-dark text-muted dark:text-muted-dark">
          Sub-50ms Cold Starts &bull; Serverless
        </span>
      </div>

      <!-- Edge Security & Logic Pipeline Grid -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-3">
        <!-- Module 1: Signature Verification -->
        <div class="p-3.5 rounded-lg border border-border/80 dark:border-border-dark/80 bg-surface dark:bg-surface-dark">
          <div class="flex items-center gap-1.5 text-accent dark:text-accent-dark mb-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 12.75 11.25 15 15 9.75m-3-7.036A11.959 11.959 0 0 1 3.598 6 11.99 11.99 0 0 0 3 9.749c0 5.592 3.824 10.29 9 11.623 5.176-1.332 9-6.03 9-11.622 0-1.31-.21-2.571-.598-3.751h-.152c-3.196 0-6.1-1.248-8.25-3.285Z" />
            </svg>
            <span class="text-xs font-mono font-semibold">{isVi ? 'Xác thực Ký số' : 'Security & Signature'}</span>
          </div>
          <p class="text-[11px] text-muted dark:text-muted-dark leading-relaxed">
            {isVi ? 'Kiểm tra token Mattermost, mã hóa HMAC & ngăn chặn replay attack' : 'Mattermost token verification, HMAC-SHA256 check & replay protection'}
          </p>
          <div class="mt-2 text-[10px] font-mono text-accent dark:text-accent-dark">HMAC Validation</div>
        </div>

        <!-- Module 2: Event Idempotency -->
        <div class="p-3.5 rounded-lg border border-border/80 dark:border-border-dark/80 bg-surface dark:bg-surface-dark">
          <div class="flex items-center gap-1.5 text-accent dark:text-accent-dark mb-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M16.023 9.348h4.992v-.001M2.985 19.644v-4.992m0 0h4.992m-4.993 0 3.181 3.183a8.25 8.25 0 0 0 13.803-3.7M4.031 9.865a8.25 8.25 0 0 1 13.803-3.7l3.181 3.182m0-4.991v4.99" />
            </svg>
            <span class="text-xs font-mono font-semibold">{isVi ? 'Khử Trùng Lặp' : 'Event Idempotency'}</span>
          </div>
          <p class="text-[11px] text-muted dark:text-muted-dark leading-relaxed">
            {isVi ? 'Bộ đệm đối chiếu UUID sự kiện đảm bảo không thực thi 2 lần khi network retry' : 'UUID deduplication cache guaranteeing zero duplicate execution on retry storms'}
          </p>
          <div class="mt-2 text-[10px] font-mono text-accent dark:text-accent-dark">Atomic Event Lock</div>
        </div>

        <!-- Module 3: State Machine Router -->
        <div class="p-3.5 rounded-lg border border-border/80 dark:border-border-dark/80 bg-surface dark:bg-surface-dark">
          <div class="flex items-center gap-1.5 text-accent dark:text-accent-dark mb-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
            </svg>
            <span class="text-xs font-mono font-semibold">{isVi ? 'Máy Trạng Thái' : 'State Machine Router'}</span>
          </div>
          <p class="text-[11px] text-muted dark:text-muted-dark leading-relaxed">
            {isVi ? 'Định tuyến luồng hội thoại theo các bước FSM xác định, an toàn và dễ kiểm thử' : 'Finite state machine directing multi-step conversational flows and button actions'}
          </p>
          <div class="mt-2 text-[10px] font-mono text-accent dark:text-accent-dark">Deterministic FSM</div>
        </div>

        <!-- Module 4: Structured Output Validator -->
        <div class="p-3.5 rounded-lg border border-border/80 dark:border-border-dark/80 bg-surface dark:bg-surface-dark">
          <div class="flex items-center gap-1.5 text-accent dark:text-accent-dark mb-1">
            <svg class="w-3.5 h-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 6.75 22.5 12l-5.25 5.25m-10.5 0L1.5 12l5.25-5.25m7.5-3-4.5 16.5" />
            </svg>
            <span class="text-xs font-mono font-semibold">{isVi ? 'Kiểm Định LLM' : 'LLM Schema Validator'}</span>
          </div>
          <p class="text-[11px] text-muted dark:text-muted-dark leading-relaxed">
            {isVi ? 'Ràng buộc đầu ra JSON có cấu trúc, loại bỏ PII và chặn phản hồi sai lệch' : 'Strict JSON Schema enforcement, automated retry on malformed outputs & PII stripping'}
          </p>
          <div class="mt-2 text-[10px] font-mono text-accent dark:text-accent-dark">Structured JSON Schema</div>
        </div>
      </div>
    </div>

    <!-- CONNECTOR ARROW 2: EDGE -> PERSISTENCE & ERP -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 my-1">
      <div class="flex flex-col items-center justify-center text-center">
        <div class="h-3 w-px bg-accent/40 dark:bg-accent-dark/40"></div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-canvas dark:bg-canvas-dark border border-border dark:border-border-dark text-[11px] font-mono text-muted dark:text-muted-dark shadow-xs">
          <svg class="w-3.5 h-3.5 text-emerald-600 dark:text-emerald-400" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 13.5 12 21m0 0-7.5-7.5M12 21V3" />
          </svg>
          <span>{isVi ? 'Giao dịch RLS & Audit Log' : 'PostgreSQL RLS Protected Writes'}</span>
        </div>
        <div class="h-3 w-px bg-accent/40 dark:bg-accent-dark/40"></div>
      </div>

      <div class="flex flex-col items-center justify-center text-center">
        <div class="h-3 w-px bg-accent/40 dark:bg-accent-dark/40"></div>
        <div class="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-canvas dark:bg-canvas-dark border border-border dark:border-border-dark text-[11px] font-mono text-muted dark:text-muted-dark shadow-xs">
          <svg class="w-3.5 h-3.5 text-accent dark:text-accent-dark" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 21 3 16.5m0 0L7.5 12M3 16.5h13.5m0-13.5L21 7.5m0 0L16.5 12M21 7.5H7.5" />
          </svg>
          <span>{isVi ? 'Đồng bộ Dữ liệu ERP & Phê duyệt' : 'Bi-directional State Sync & Action Approval'}</span>
        </div>
        <div class="h-3 w-px bg-accent/40 dark:bg-accent-dark/40"></div>
      </div>
    </div>

    <!-- LAYER 3: PERSISTENCE & BACKOFFICE LAYER -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
      <!-- Database Box -->
      <div class="rounded-xl border border-border/70 dark:border-border-dark/70 bg-canvas/40 dark:bg-canvas-dark/40 p-4 sm:p-5">
        <div class="flex items-center justify-between gap-2 mb-3">
          <div class="flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-sm bg-emerald-500"></span>
            <h4 class="text-xs sm:text-sm font-mono font-semibold uppercase tracking-wider text-ink dark:text-ink-dark">
              {isVi ? 'Cơ sở Dữ liệu / Supabase PostgreSQL' : 'Persistence / Supabase PostgreSQL Database'}
            </h4>
          </div>
          <span class="text-[10px] font-mono px-2 py-0.5 rounded bg-emerald-500/10 text-emerald-600 dark:text-emerald-400">
            Zero-Trust RLS
          </span>
        </div>

        <ul class="space-y-2.5">
          <li class="p-2.5 rounded-lg bg-surface dark:bg-surface-dark border border-border dark:border-border-dark">
            <div class="flex items-center justify-between">
              <span class="text-xs font-semibold text-ink dark:text-ink-dark">
                {isVi ? 'Chính sách Bảo mật Cấp hàng (RLS)' : 'Row-Level Security (RLS)'}
              </span>
              <span class="text-[10px] font-mono text-muted dark:text-muted-dark">SQL Engine Level</span>
            </div>
            <p class="text-[11px] text-muted dark:text-muted-dark mt-0.5">
